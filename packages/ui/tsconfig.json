{
  "extends": "@orchestrix/typescript-config/react-library.json",
  "include": ["src"],
  "compilerOptions": {
    "jsx": "react",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitReturns": false
  },
  "exclude": ["dist", "node_modules"]
}
